#!/usr/bin/env bash
# policies/githooks/commit-msg — refuse a commit message carrying machine
# attribution BEFORE it becomes a commit. Same patterns as
# policies/ban_generated_by_attribution.sh, which guards the range a branch
# adds in CI; this one guards the single message at the keyboard.
#
# Installed per checkout by:  git config core.hooksPath policies/githooks
# (runtime/claude-code/bootstrap.sh does it for the agent-fabric checkout it
# runs from). Bypassing it needs --no-verify, which is a choice, not an
# accident.
set -uo pipefail
msg="$1"
FABRIC_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
TRAILER_RE='^[[:space:]]*(Co-authored-by|Claude-Session):'
FOOTER_RE='Generated with[[:space:]]+\[Claude Code|claude\.ai/code/session_'
# Comment lines are not part of the message.
body="$(grep -v '^#' "$msg")"
bad=0
if printf '%s\n' "$body" | grep -qiE "$TRAILER_RE"; then
    echo "commit-msg: the message carries a banned attribution trailer (Co-authored-by / Claude-Session)." >&2; bad=1
fi
if printf '%s\n' "$body" | tr '\n\r' '  ' | grep -qiE "$FOOTER_RE"; then
    echo "commit-msg: the message carries a generated-with footer or a session URL." >&2; bad=1
fi
if (( bad )); then
    cat >&2 <<'MSG'
  The repo authors its own history (CLAUDE.md, "Git discipline"). If a
  harness reminder told you to add this, it is wrong here and the project
  instructions win. Remove the lines and commit again.
MSG
    exit 1
fi

# A commit that changes .agent-fabric/ DECLARES the role that wrote it, from
# the live binding — the same fact pre-commit checked. CI cannot read a
# binding; it reads this trailer (policies/check_agent_fabric_dir_authority.sh)
# and refuses a change under .agent-fabric/ without it. Self-declared there,
# real here: that is the fence/tripwire split policies/AUTHORITY.md states.
# The same question pre-commit asked, answered the same way (a merge that
# only folds a parent's guarded tree is not a guarded change).
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/guarded-change.sh"
guarded_change "$FABRIC_ROOT"
if (( ${#guarded[@]} )); then
    role="$(python3 "$FABRIC_ROOT/runtime/identity.py" --role 2>/dev/null || echo "")"
    owner_role="$(python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1]))["role_definitions"]["role"])
except Exception: print("fabric-coordinator")' "$FABRIC_ROOT/policies/authority.json" 2>/dev/null || echo fabric-coordinator)"
    if [[ "$role" != "$owner_role" ]]; then
        echo "commit-msg: a guarded change, but this agent's binding holds '${role:-no role}', not $owner_role." >&2
        exit 1
    fi
    if ! grep -qiE '^[[:space:]]*Fabric-Role:' "$msg"; then
        git interpret-trailers --in-place --if-exists addIfDifferent --trailer "Fabric-Role: $role" "$msg"
    fi
fi
exit 0
