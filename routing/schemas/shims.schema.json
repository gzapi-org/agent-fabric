{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-fabric:routing:shims",
  "title": "Model family -> compatibility shim",
  "type": "object",
  "required": ["version", "shims"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "shims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family", "shim", "harness"],
        "additionalProperties": false,
        "properties": {
          "family": {
            "description": "A glob over canonical model ids (fnmatch): `z-ai/glm-*`.",
            "type": "string",
            "minLength": 1
          },
          "shim": {
            "description": "What is attached to a model of this family for the harness: an OpenRouter preset reference.",
            "type": "string",
            "pattern": "^@preset/[a-z0-9-]+$"
          },
          "harness": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "tested": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
