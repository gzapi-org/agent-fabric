#!/usr/bin/env bash
# runtime/openrouter/launch
#
# Launch this agent's Claude Code session through OpenRouter, with the
# capability classes resolved from agent-fabric's routing files.
#
#   runtime/openrouter/launch [claude args...]     # resolve, export, exec (broker)
#   runtime/openrouter/launch --provider anthropic # the same, on plain claude
#   runtime/openrouter/launch --print              # resolve and print; no exec
#
# WHY THIS EXISTS. Launching is a decision no session can make for itself:
# one launch decides the provider for EVERYTHING under it, subagents
# included. Neither modelOverrides nor repo settings can do this:
# modelOverrides is taken as the WHOLE MAP from the highest precedence
# scope that sets it (so any scope both paths share binds both paths),
# while ANTHROPIC_DEFAULT_*_MODEL are OVERRIDABLE process env — the
# launcher exports them, `exec ori claude` carries them to every agent.
#
# WHAT IT RESOLVES (tools/fabric/routing.py is the one implementation):
#   capability class -> model     routing/capabilities.json (openrouter)
#                                 <- routing/profiles.json defaults
#                                 <- roles.<role>        (the agent's binding)
#                                 <- agents.<login>      (the agent itself)
#                                 <- $STATE_DIR/model-profile.local.json (gitignored)
#   model -> family shim          routing/shims.json
#   class -> harness alias        runtime/claude-code/aliases.json
# and exports, per class, ANTHROPIC_DEFAULT_<ALIAS>_MODEL=<model@shim>.
# The composite string exists only here, in the child's environment.
# Every class rides an alias: the Agent tool's `model` field accepts
# only the tier aliases, so a "declared full id" in an agent file can
# never be named by a dispatch (verified live 2026-09-13 — the reviewer
# fell through to the opus alias and ran on GLM). The review class
# rides `fable`, the alias no coding class uses, so its export is its
# own and the review gate below guards exactly that export.
#
# WHO IS LAUNCHING. The agent is the Linux login (runtime/identity.py);
# the role comes from that agent's runtime binding (tools/fabric/role.py).
# The launch DIRECTORY decides which settings scopes are fenced and which
# working copy the child starts in; it never decides who the agent is.
#
# The merged REVIEW model MUST be in routing/policies/review-grade.json:
# a review's failure mode is a green PR that merges, so the reviewer's
# model is never a cost cut. Lint enforces this on the committed files;
# the launcher enforces it again on the MERGED result, because the local
# override layer is where a cheap-reviewer experiment would sneak in.
# The coding classes are not gated.
#
# REFUSES, fail-closed, before spawning anything:
#   - no runtime binding for this agent      -> "run /role first"
#   - routing/capabilities.json missing
#   - merged review model not review-grade
#   - pass-through args carrying --settings or --setting-sources
#     (ori's own provider fence uses --settings; a caller's one would
#     override it and the session could silently leave OpenRouter)
#   - any settings scope (the managed-policy file, ~/.claude/settings.json,
#     ~/.claude/settings.local.json, $CLAUDE_CONFIG_DIR/settings.json, the
#     launch working copy's and $PWD's .claude/settings{,.local}.json)
#     carrying a model pin — env.ANTHROPIC_*, env.CLAUDE_CODE_SUBAGENT_MODEL,
#     modelOverrides — or CLAUDE_CODE_SUBAGENT_MODEL in the caller's
#     environment (a settings-scope pin outranks the profile's exports;
#     the subagent variable overrides every dispatch's model)
#   - a merged model that is not a model id (a local override of null, a
#     number, "" or prose)
#   - ori not authenticated, or authenticated from anything but the
#     environment (`ori auth --json`: authenticated AND source.kind ==
#     environment, exit 0)
#
# NEVER: CLAUDE_CODE_SUBAGENT_MODEL_FORCE. It discards every dispatch's
# own model and forces the parent's; capability classes would stop
# meaning anything.
#
# CREDENTIAL: an OpenRouter API key per agent account, as
# OPENROUTER_API_KEY in that account's environment — exported by
# ~/.config/agent-fabric/secrets.env, which `fabric-secrets sync` writes
# from the account's own Doppler config (runtime/provisioning/README.md,
# "Secrets") — never in the repo.
set -uo pipefail

FABRIC_ROOT="${AGENT_FABRIC_ROOT:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)}"
IDENTITY="$FABRIC_ROOT/runtime/identity.py"
ROUTING="$FABRIC_ROOT/tools/fabric/routing.py"
CAPABILITIES="$FABRIC_ROOT/routing/capabilities.json"
ALIASES="$FABRIC_ROOT/runtime/claude-code/aliases.json"

# Derived from the launch directory ONLY — never inherited. The scopes this
# fence inspects must be the scopes the child loads, and the child starts
# in $PWD: an inherited REPO_ROOT pointing at another clone let the fence
# pass on that clone's clean .claude/ while exec'ing in this one, pinned
# (review on gzapp PR #679, judged CONFIRMED).
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

die() { echo "launch: $*" >&2; exit 1; }

# --print may sit anywhere in the arguments; as $1 only, `launch --verbose
# --print` passed it through to claude and exec'd a real session.
# --provider openrouter (default) | anthropic: the same resolution and the
# same refusals, then `ori claude` with every class exported as a
# composite, or plain `claude` with only the classes the anthropic column
# pins (a native Claude id) exported — a tier alias there is left to the
# harness. Either way the session is the fabric's: bound role, gated
# review model, no pin outside the profile.
PRINT_ONLY=0
PROVIDER="openrouter"
ARGS=()
prev_arg=""
for arg in "$@"; do
    if [[ "$arg" == "--print" ]]; then PRINT_ONLY=1
    elif [[ "$prev_arg" == "--provider" ]]; then PROVIDER="$arg"
    elif [[ "$arg" == --provider=* ]]; then PROVIDER="${arg#--provider=}"
    elif [[ "$arg" == "--provider" ]]; then :
    else ARGS+=("$arg"); fi
    prev_arg="$arg"
done
set -- "${ARGS[@]+"${ARGS[@]}"}"
[[ "$PROVIDER" == openrouter || "$PROVIDER" == anthropic ]] || { echo "launch: --provider must be openrouter or anthropic, not '$PROVIDER'" >&2; exit 1; }

# ── who is launching ────────────────────────────────────────────────
[[ -f "$IDENTITY" ]] || die "$IDENTITY is missing — is AGENT_FABRIC_ROOT right?"
CONTEXT="$(python3 "$IDENTITY" --json --cwd "$PWD")" || die "could not resolve the agent identity."
AGENT="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["agent"])' <<<"$CONTEXT")"
ROLE="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("role") or "")' <<<"$CONTEXT")"
STATE_DIR="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["state_dir"])' <<<"$CONTEXT")"
LOCAL_OVERRIDE="$STATE_DIR/model-profile.local.json"

# ── refusals ────────────────────────────────────────────────────────
[[ -n "$ROLE" ]] || die "agent '$AGENT' has no active role binding ($STATE_DIR/binding.json).
  The launcher resolves the profile from the agent's role. Run
  /role <role> first, then re-run."
[[ -f "$CAPABILITIES" ]] || die "$CAPABILITIES is missing."
[[ -f "$ALIASES" ]] || die "$ALIASES is missing."
if [[ "$PROVIDER" == openrouter ]]; then
    command -v ori >/dev/null 2>&1 || die "the ori CLI is not on PATH."
else
    command -v claude >/dev/null 2>&1 || die "claude is not on PATH."
fi

# Pass-through args must not be able to fence ori out of OpenRouter.
for arg in "$@"; do
    [[ "$arg" == --settings || "$arg" == --settings=* ]] &&
        die "passing --settings would disable ori's provider fence (its own
  --settings carries apiKeyHelper and blanks every other provider
  variable). Launch without it; per-session settings go through the
  profile layers, not the CLI."
    [[ "$arg" == --setting-sources || "$arg" == --setting-sources=* ]] &&
        die "passing --setting-sources would disable ori's provider fence."
done

# A settings-scope pin outranks the profile's exports (ori composes the
# child env as settings-env-first for the four alias keys; Claude Code
# merges every scope's env block into the process, local > project >
# user), so the launcher refuses rather than race — in EVERY scope. The
# predicate: env.ANTHROPIC_* (not only _DEFAULT_ — ANTHROPIC_MODEL is a
# pin too), env.CLAUDE_CODE_SUBAGENT_MODEL, modelOverrides. NOT a top-
# level `model`: that is the session default, which the explicit
# `--model <session>` this launcher passes outranks. An unreadable file
# is not evidence of pins. $PWD's .claude/ is scanned as well when the
# launch directory is not the toplevel, and the managed-policy file
# (root-owned; outranks every other scope) — a missing file is skipped.
for f in /etc/claude-code/managed-settings.json \
         "$HOME/.claude/settings.json" "$HOME/.claude/settings.local.json" \
         "${CLAUDE_CONFIG_DIR:+$CLAUDE_CONFIG_DIR/settings.json}" \
         "$REPO_ROOT/.claude/settings.json" "$REPO_ROOT/.claude/settings.local.json" \
         "$PWD/.claude/settings.json" "$PWD/.claude/settings.local.json"; do
    [[ -n "$f" && -f "$f" ]] || continue
    PINS="$(python3 - "$f" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1])) or {}
except Exception:
    sys.exit(0)
bad = []
env = d.get("env") or {}
if isinstance(env, dict):
    bad += sorted("env." + k for k in env if k.startswith("ANTHROPIC_") or k == "CLAUDE_CODE_SUBAGENT_MODEL")
if "modelOverrides" in d: bad.append("modelOverrides")
print(" ".join(bad))
PY
)"
    [[ -z "$PINS" ]] || die "$f carries model pins ($PINS), which would silently outrank the profile. Remove them; per-agent tiers go through $LOCAL_OVERRIDE."
done
[[ -z "${CLAUDE_CODE_SUBAGENT_MODEL:-}" ]] ||
    die "CLAUDE_CODE_SUBAGENT_MODEL is set in the environment; it overrides every subagent's model regardless of the review gate. Unset it."
[[ -z "${CLAUDE_CODE_SUBAGENT_MODEL_FORCE:-}" ]] ||
    die "CLAUDE_CODE_SUBAGENT_MODEL_FORCE is set; it discards every dispatch's own model. Unset it."

# ── resolve ─────────────────────────────────────────────────────────
RESOLVED="$(AGENT_FABRIC_ROOT="$FABRIC_ROOT" python3 - "$ROUTING" "$ALIASES" "$LOCAL_OVERRIDE" "$ROLE" "$AGENT" "$PROVIDER" <<'PY'
import importlib.util, json, os, re, sys
routing_path, aliases_path, local_path, role, agent, provider = sys.argv[1:7]
spec = importlib.util.spec_from_file_location("fabric_routing", routing_path)
routing = importlib.util.module_from_spec(spec); spec.loader.exec_module(routing)
local = {}
if os.path.exists(local_path):
    local = json.load(open(local_path))
    if not isinstance(local, dict):
        sys.exit("model-profile.local.json is %s, not an object" % type(local).__name__)
aliases = json.load(open(aliases_path))
# Every merged model must be a model id: the committed files are linted,
# the local layer is not, and a null/number/""/prose there once passed the
# emptiness checks as the string "None" and reached `--model`.
def valid(name, val):
    if not isinstance(val, str) or not routing.MODEL_ID.fullmatch(val):
        sys.exit("merged profile: %s is %r, not a model id (%s)" % (name, val, routing.MODEL_ID.pattern))
merged = routing.merged_profile(role, agent, local)
valid("session", merged.get("session"))
for klass, val in (merged.get("capabilities") or {}).items():
    valid("capabilities." + klass, val)
out = {"role": role, "agent": agent, "provider": provider, "exports": {}, "classes": {}}
for klass, alias in aliases["aliases"].items():
    res = routing.resolve(klass, provider, role, agent, local)
    if provider == "openrouter":
        if not routing.COMPOSITE.fullmatch(res["composite"]):
            sys.exit("resolved %s is %r, not a composite model reference" % (klass, res["composite"]))
        out["exports"][aliases["env"][alias]] = res["composite"]
    # On plain claude a pinned class is NOT exported: ANTHROPIC_DEFAULT_*
    # would rebind the alias for the whole session (a hand /model fable
    # would land on the review model). The pin reaches the class through
    # its agent file (bootstrap writes it from routing) and the dispatch
    # guard, which drops the dispatch's alias under this launch so the
    # file decides. Nothing is exported on this path.
    out["classes"][klass] = res
try:
    session = routing.resolve_session(role, agent, local, provider=provider)
except KeyError as exc:
    sys.exit(str(exc))
out["session"] = session
grade = routing.load_review_grade()
review = out["classes"].get(grade.get("capability", "review"))
if review and not routing.review_grade_ok(review["model"]):
    out["review_violation"] = review["model"]
print(json.dumps(out))
PY
)" || die "could not resolve the profile (see the message above)."

VIOLATION="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("review_violation") or "")' <<<"$RESOLVED")"
[[ -z "$VIOLATION" ]] || die "merged review model '$VIOLATION' is not in routing/policies/review-grade.json.
  A review's failure mode is a green PR that merges, so the reviewer's
  model is policy, not a cost dial. Change the profile or extend
  review-grade.json through fabric-coordinator (policies/AUTHORITY.md)."

SESSION="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["session"]["composite"])' <<<"$RESOLVED")"

# ── the pins ─────────────────────────────────────────────────────────
while IFS='=' read -r name value; do
    [[ -n "$name" ]] || continue
    export "$name=$value"
done < <(python3 -c 'import json,sys; [print(f"{k}={v}") for k, v in sorted(json.load(sys.stdin)["exports"].items())]' <<<"$RESOLVED")

# Auth: ori must be working from the environment BEFORE we exec, because a
# prompt at this point would come after we already exported the pins.
# The check is a CONJUNCTION on the documented shape — {"ok":true,"data":
# {"authenticated":true,"source":{"kind":"environment",...}}} — and keeps
# ori's exit status. Plain claude carries its own login; nothing to check.
if [[ "$PROVIDER" == openrouter ]]; then
AUTH="$(ori auth --json 2>/dev/null)"; AUTH_RC=$?
if [[ $AUTH_RC -ne 0 ]] || ! python3 - "$AUTH" <<'PY'
import json, sys
try:
    d = json.loads(sys.argv[1] or "{}")
except Exception:
    sys.exit(1)
if not isinstance(d, dict): sys.exit(1)
data = d.get("data") if isinstance(d.get("data"), dict) else d
src = data.get("source") if isinstance(data.get("source"), dict) else {}
sys.exit(0 if data.get("authenticated") is True and src.get("kind") == "environment" else 1)
PY
then
    die "ori is not authenticated from the environment (ori auth exit $AUTH_RC). This account needs OPENROUTER_API_KEY in its environment (~/.config/agent-fabric/secrets.env via fabric-secrets sync) — a stored \`ori login\` credential is deliberately not accepted, because per-agent spend follows the key (ori auth --json to inspect)."
fi
fi

LABEL="$ROLE/$AGENT"

# The session model reaches claude only as `--model`, which nothing inside
# the session can read back — so model-audit.sh could not report it. Stamp
# it into the child's environment, together with the profile it came from.
# The stamp records what is ACTUALLY applied: an explicit --model on the
# command line wins, so when the caller passes one, that value is stamped.
EFFECTIVE_SESSION="$SESSION"
CALLER_MODEL=0
prev=""
for arg in "$@"; do
    if [[ "$prev" == "--model" ]]; then EFFECTIVE_SESSION="$arg"; CALLER_MODEL=1; fi
    if [[ "$arg" == --model=* ]]; then EFFECTIVE_SESSION="${arg#--model=}"; CALLER_MODEL=1; fi
    prev="$arg"
done
export AGENT_FABRIC_LAUNCH_SESSION_MODEL="$EFFECTIVE_SESSION"
export AGENT_FABRIC_LAUNCH_PROFILE="$LABEL"
export AGENT_FABRIC_LAUNCH_AGENT="$AGENT"
export AGENT_FABRIC_LAUNCH_PROVIDER="$PROVIDER"

if (( PRINT_ONLY )); then
    echo "# resolved profile for $LABEL (agent $AGENT, role $ROLE, provider $PROVIDER)"
    echo "  session : $SESSION"
    SKIPPED="$(python3 -c 'import json,sys; s=json.load(sys.stdin)["session"]; print(s.get("skipped") or "")' <<<"$RESOLVED")"
    [[ -z "$SKIPPED" ]] || echo "  (the merged session $SKIPPED is not an Anthropic model; the $(python3 -c 'import json,sys; print(json.load(sys.stdin)["session"]["source"])' <<<"$RESOLVED") layer's is used on plain claude)"
    [[ "$EFFECTIVE_SESSION" == "$SESSION" ]] || echo "  (overridden by --model on the command line: $EFFECTIVE_SESSION)"
    python3 - "$RESOLVED" <<'PY'
import json, sys
d = json.loads(sys.argv[1])
for klass, res in d["classes"].items():
    if d.get("provider") == "anthropic":
        print("  %-12s: %s  %s" % (klass, res["model"], "(pinned in the agent file; the dispatch guard applies it)" if res.get("pinned") else "(harness default for the alias)"))
    else:
        print("  %-12s: %s  shim %s  => %s" % (klass, res["model"], res["shim"] or "-", res["composite"]))
print()
for k, v in sorted(d["exports"].items()):
    print("  export %s=%s" % (k, v))
PY
    echo "  export AGENT_FABRIC_LAUNCH_SESSION_MODEL=$AGENT_FABRIC_LAUNCH_SESSION_MODEL"
    echo "  export AGENT_FABRIC_LAUNCH_PROFILE=$AGENT_FABRIC_LAUNCH_PROFILE"
    echo "  export AGENT_FABRIC_LAUNCH_PROVIDER=$AGENT_FABRIC_LAUNCH_PROVIDER"
    exit 0
fi

# Plain claude: no broker, no shim, no tier export — a pinned class is
# served by its agent file under the dispatch guard; the session model
# and the refusals are what the launcher contributed.
if [[ "$PROVIDER" == anthropic ]]; then
    if (( CALLER_MODEL )); then exec claude "$@"; fi
    exec claude --model "$SESSION" "$@"
fi

# When the caller supplied --model, the launcher's own is OMITTED rather
# than placed first: "last wins" would be an assumption about claude's
# argv handling, and the stamp above must not be able to disagree with
# what the child actually applies.
if (( CALLER_MODEL )); then
    exec ori claude "$@"
fi
exec ori claude --model "$SESSION" "$@"
