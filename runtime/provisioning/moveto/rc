# Sourced by the shell `moveto` spawns. Not a general bashrc.
#
# The normal chain is sourced FIRST, then the title write is added, because
# /etc/bashrc puts an OSC 0 title write of its own into PROMPT_COMMAND at every
# prompt.
#
# On Fedora PROMPT_COMMAND is an ARRAY (Debian's /etc/bash.bashrc sets no
# title write of its own, so the string form below is the whole story
# there; verified on Fedora, a profile only on Debian — platform/README.md) — /etc/bashrc does `declare -a
# PROMPT_COMMAND` and sets element 0; vte.sh and the systemd OSC-context hook
# then APPEND further elements. A string assignment like the one below reads
# and writes element 0 only, so it neither disturbs those hooks nor runs after
# them: ours is appended INSIDE element 0 and runs before elements 1..n. That
# is fine here only because vte.sh deliberately leaves the title alone in the
# array case. A ~/.bashrc that appends its own title hook as a later element
# would win over this one.

if [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
elif [ -f /etc/bashrc ]; then
    . /etc/bashrc                 # Fedora
elif [ -f /etc/bash.bashrc ]; then
    . /etc/bash.bashrc            # Debian
fi

if [ -n "${MOVETO_TITLE:-}" ]; then
    PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND$'\n'}"'printf "\033]1;%s\007\033]2;%s\007" "$MOVETO_TITLE" "$MOVETO_TITLE"'
fi
