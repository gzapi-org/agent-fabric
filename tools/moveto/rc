# Sourced by the shell `moveto` spawns. Not a general bashrc.
#
# /etc/bashrc sets PROMPT_COMMAND to rewrite the window title as
# user@host:cwd at every prompt, so a one-shot title is overwritten
# immediately. This sources the normal chain FIRST and then replaces that
# hook, which is the only ordering that wins.

if [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
elif [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# APPEND rather than replace. /etc/bashrc's hook is only the title, but this
# host also has VTE shell integration in the prompt chain, and clobbering the
# variable would take whatever else lives there with it. Ours runs LAST, so it
# is the write that lands.
if [ -n "${MOVETO_TITLE:-}" ]; then
    PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND$'\n'}"'printf "\033]1;%s\007\033]2;%s\007" "$MOVETO_TITLE" "$MOVETO_TITLE"'
fi
